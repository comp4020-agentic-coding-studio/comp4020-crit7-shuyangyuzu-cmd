---
// Shared markup for the fixed 08:00-22:00 time-axis weekly grid: the day-tab
// row (mobile day-switcher), the sticky day-header row, and the day columns
// themselves. Used twice — once for the manual preview's own grid
// (`planner.astro`'s `#weekly-grid`), and once inside the generated-plan
// detail view (`#plan-detail-grid`) — so both grids share one markup source
// and can never drift apart. Neither instance's session blocks are rendered
// here: those are always filled in client-side (see `renderSlotsIntoGrid` in
// planner.astro's client script), since which sessions to show depends on
// client-only state (the manual preview, or a just-generated plan) that the
// server never has for the manual-preview instance and never persists for
// either.
import { GRID_END_MINUTES, GRID_START_MINUTES, PX_PER_HOUR } from "../lib/scheduling";

interface Props {
  gridId: string;
  dayTabsId: string;
  ariaLabel: string;
  hidden?: boolean;
}
const { gridId, dayTabsId, ariaLabel, hidden = false } = Astro.props;

const DAY_NAMES = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
const DAY_ABBR = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const gridHours = (GRID_END_MINUTES - GRID_START_MINUTES) / 60; // 14
const gridHeightPx = gridHours * PX_PER_HOUR; // 896
const hourLabels = Array.from({ length: gridHours + 1 }, (_, i) => GRID_START_MINUTES / 60 + i); // 8..22
const todayIndex = (new Date().getDay() + 6) % 7;
---

<div id={gridId} class="weekly-grid" hidden={hidden}>
  <div class="day-tabs" id={dayTabsId} role="tablist" aria-label={ariaLabel}>
    {
      DAY_ABBR.map((abbr, day) => (
        <button
          type="button"
          class={`day-tab${day === todayIndex ? " mobile-active" : ""}`}
          data-day={day}
          role="tab"
          aria-selected={day === todayIndex ? "true" : "false"}
        >
          {abbr}
        </button>
      ))
    }
  </div>
  <div class="weekly-grid-scroll">
    <div class="weekly-grid-header">
      <div class="time-axis-spacer" aria-hidden="true"></div>
      {
        DAY_NAMES.map((name, day) => (
          <div class={`day-header${day === todayIndex ? " mobile-active" : ""}`} data-day={day}>
            {name}
          </div>
        ))
      }
    </div>
    <div class="weekly-grid-body" style={`--hour-px: ${PX_PER_HOUR}px; --grid-height: ${gridHeightPx}px;`}>
      <div class="time-axis">
        {
          hourLabels.map((hour) => (
            <div class="hour-label" style={`top: ${(hour - GRID_START_MINUTES / 60) * PX_PER_HOUR}px;`}>
              {String(hour % 24).padStart(2, "0")}:00
            </div>
          ))
        }
      </div>
      {
        DAY_NAMES.map((_, day) => (
          <div class={`day-column${day === todayIndex ? " mobile-active" : ""}`} data-day={day}>
            <div class="day-column-blocks"></div>
          </div>
        ))
      }
    </div>
  </div>
</div>
