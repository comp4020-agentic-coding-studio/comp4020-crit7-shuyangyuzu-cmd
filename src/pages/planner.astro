---
// Phase 3 (page split + manual scheduling): MyTimetable-style layout — a
// compact left list of candidates you schedule from, and a large weekly grid
// on the right that updates the moment you change anything. Adding/removing
// candidates and the required flag now live on /courses/; this page only
// reads the candidate list (server truth) to build the left panel from.
//
// The preview itself (which candidates are "in" this visit, which tutorial
// time/room each has) is still never persisted server-side — PLAN.md/
// CLAUDE.md require it to start empty on a first visit and never silently
// become the confirmed enrolment. What's new this round: it now survives
// navigating to /courses/ and back, via sessionStorage (see the client
// script), reconciled on load against whichever courses are still actual
// candidates — so removing a candidate on /courses/ can never leave a ghost
// entry in a stale preview.
import { listCandidates, listConfirmedEnrollments, listCourses } from "../lib/db";
import "../styles.css";

const courses = listCourses();
const candidates = listCandidates();
const confirmed = listConfirmedEnrollments();

const DAY_NAMES = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

function pad(n: number): string {
  return String(n).padStart(2, "0");
}
function fmtTime(minutes: number): string {
  return `${pad(Math.floor(minutes / 60))}:${pad(minutes % 60)}`;
}
function fmtSession(s: { dayOfWeek: number; startMinutes: number; endMinutes: number }): string {
  return `${DAY_NAMES[s.dayOfWeek]} ${fmtTime(s.startMinutes)}–${fmtTime(s.endMinutes)}`;
}

// Embedded as the client script's only source of truth for course/session
// data and the persisted candidate list, so the JS re-render it does on load
// can never drift from what the server actually has. `<script type=
// "application/json">` is a raw-text element, so this needs manual escaping
// of "</" rather than Astro's default HTML-entity escaping (which would
// corrupt the JSON).
const plannerDataJson = JSON.stringify({
  courses,
  candidates: candidates.map((c) => ({ courseId: c.courseId, required: c.required === 1 })),
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Planner (demo) — COMP4020 prototype</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Guestbook</a>
      <a href="/courses/">Courses</a>
      <a href="/planner/">Planner</a>
      <a href="/readme/">About</a>
    </nav>
    <main class="planner">
      <h1>Planner</h1>

      <p class="disclaimer" role="note">
        <strong>Prototype, not an official ANU service.</strong> This is a student-built
        course-planning tool for a COMP4020 assignment — it is not Programs and Courses, ANUHub
        or Timetable, and never contacts any real ANU system. Every course, course code and
        session time on this page is fictional demo data. There is no login: everyone who opens
        this page is viewing and editing the same single demo student's saved candidates and
        confirmed enrolment. Lectures are always shown but never block a plan here — this
        prototype assumes a lecture can always be caught up on as a recording; only a clash
        between two tutorials actually blocks anything.
      </p>

      <section aria-labelledby="candidates-heading" class="planner-layout">
        <div class="planner-left">
          <h2 id="candidates-heading">Your candidates</h2>
          <p>
            Tick a candidate to add it to your current preview below, then pick a tutorial time
            (and a room, if that time has more than one). Add or remove candidates on the{" "}
            <a href="/courses/">courses page</a>.
          </p>
          <p id="candidates-empty-note" hidden={candidates.length > 0}>
            You don't have any candidates yet — add some on the <a href="/courses/">courses page</a>{" "}
            first.
          </p>
          <div id="candidate-schedule-list">
            {
              // Server-rendered as "nothing chosen yet" for every candidate —
              // exactly what an empty preview looks like, since the preview
              // itself only exists client-side (sessionStorage). The client
              // script re-renders this same list immediately on load once it
              // knows the real (reconciled) preview state; until JS runs, a
              // reader still sees every candidate and an honest starting
              // point rather than a blank div.
              candidates.map((c) => (
                <article class="schedule-card" data-course-id={c.courseId}>
                  <h3>
                    {c.course.code} {c.required === 1 && <span class="badge">Required</span>}
                  </h3>
                  <label class="preview-toggle">
                    <input type="checkbox" class="preview-include-checkbox" data-course-id={c.courseId} />
                    Include in current preview
                  </label>
                </article>
              ))
            }
          </div>
          <div id="conflict-banners" role="status" aria-live="polite"></div>
        </div>
        <div class="planner-right">
          <h2>Weekly grid</h2>
          <p id="preview-empty-note">
            Nothing is in your current preview yet. Tick a candidate on the left to add it.
          </p>
          <div id="weekly-grid" class="weekly-grid" hidden></div>
        </div>
      </section>

      <section aria-labelledby="confirmed-heading">
        <h2 id="confirmed-heading">Your confirmed enrolment</h2>
        <p>
          Read-only on this page — confirming a new plan or ending this one is a later phase, not
          built here yet. Nothing on this page (your preview, choosing a tutorial or room) ever
          changes what's listed here.
        </p>
        {
          confirmed.length === 0 ? (
            <p>You don't have a confirmed enrolment yet.</p>
          ) : (
            <ul id="confirmed-list">
              {confirmed.map((e) => (
                <li>
                  {e.course.code} — tutorial {e.tutorialSession.label}: {fmtSession(e.tutorialSession)} —{" "}
                  {e.tutorialSession.location}
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </main>
    <script type="application/json" id="planner-data" set:html={plannerDataJson} />
    <script>
      import { type KindedSlot, classifyOverlap, groupTutorialTimeOptions } from "../lib/scheduling";

      type SessionRow = { id: number; kind: "lecture" | "tutorial"; label: string; dayOfWeek: number; startMinutes: number; endMinutes: number; location: string };
      type CourseRow = { id: number; code: string; title: string; sessions: SessionRow[] };

      const DAY_NAMES = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
      const pad = (n: number) => String(n).padStart(2, "0");
      const fmtTime = (m: number) => `${pad(Math.floor(m / 60))}:${pad(m % 60)}`;
      const fmtSession = (s: { dayOfWeek: number; startMinutes: number; endMinutes: number }) =>
        `${DAY_NAMES[s.dayOfWeek]} ${fmtTime(s.startMinutes)}–${fmtTime(s.endMinutes)}`;
      const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

      const dataEl = document.getElementById("planner-data");
      const data = JSON.parse(dataEl?.textContent ?? "{}") as {
        courses: CourseRow[];
        candidates: { courseId: number; required: boolean }[];
      };

      const courses: CourseRow[] = data.courses ?? [];
      const courseById = new Map(courses.map((c) => [c.id, c]));
      // courseId -> required. Presence in this map means "is a candidate" —
      // the persisted, server-truth state this page's left panel is built
      // from (this page never mutates it; that only happens on /courses/).
      const candidates = new Map<number, { required: boolean }>((data.candidates ?? []).map((c) => [c.courseId, { required: c.required }]));

      // Client-only preview: courseId -> chosen time/room, or "in preview but
      // nothing chosen yet" (dayOfWeek === null). Never sent to the server,
      // never touches candidates or confirmed enrolment. Persisted to
      // sessionStorage so it survives a trip to /courses/ and back, but nowhere
      // else — closing the tab or opening a new one starts fresh, matching the
      // "never needs to survive a reload" rule for a *single* visit's browser
      // session PLAN.md/CLAUDE.md set out, just extended across this app's own
      // two pages rather than one.
      type PreviewEntry = { dayOfWeek: number | null; startMinutes: number | null; endMinutes: number | null; sessionId: number | null };
      const PREVIEW_STORAGE_KEY = "planner-preview-v1";

      function loadPreviewFromStorage(): Map<number, PreviewEntry> {
        try {
          const raw = sessionStorage.getItem(PREVIEW_STORAGE_KEY);
          if (!raw) return new Map();
          const parsed = JSON.parse(raw) as [number, PreviewEntry][];
          if (!Array.isArray(parsed)) return new Map();
          return new Map(parsed);
        } catch {
          return new Map();
        }
      }

      function savePreviewToStorage() {
        try {
          sessionStorage.setItem(PREVIEW_STORAGE_KEY, JSON.stringify([...preview.entries()]));
        } catch {
          // sessionStorage can throw (private browsing, quota) — the preview
          // still works for this page view, it just won't survive a
          // navigation. Not worth surfacing as an error to the visitor.
        }
      }

      const preview = loadPreviewFromStorage();

      // Reconcile the restored preview against the *current* candidate list
      // and course data before rendering anything: drop any course that's no
      // longer a candidate (removed on /courses/ since this preview was
      // saved), and re-validate any chosen time/room still actually exists —
      // falling back to "time chosen, room pending" or "nothing chosen yet"
      // rather than pointing at a session id that no longer exists.
      for (const courseId of [...preview.keys()]) {
        const course = courseById.get(courseId);
        if (!candidates.has(courseId) || !course) {
          preview.delete(courseId);
          continue;
        }
        const entry = preview.get(courseId)!;
        if (entry.dayOfWeek == null) continue;
        const options = groupTutorialTimeOptions(course.sessions.filter((s) => s.kind === "tutorial"));
        const match = options.find((o) => o.dayOfWeek === entry.dayOfWeek && o.startMinutes === entry.startMinutes && o.endMinutes === entry.endMinutes);
        if (!match) {
          preview.set(courseId, { dayOfWeek: null, startMinutes: null, endMinutes: null, sessionId: null });
        } else if (entry.sessionId != null && !match.sections.some((s) => s.id === entry.sessionId)) {
          preview.set(courseId, {
            dayOfWeek: match.dayOfWeek,
            startMinutes: match.startMinutes,
            endMinutes: match.endMinutes,
            sessionId: match.sections.length === 1 ? match.sections[0].id : null,
          });
        }
      }
      savePreviewToStorage();

      const scheduleListEl = document.getElementById("candidate-schedule-list")!;
      const conflictBannersEl = document.getElementById("conflict-banners")!;
      const previewEmptyNote = document.getElementById("preview-empty-note")!;
      const weeklyGridEl = document.getElementById("weekly-grid")!;

      // Every currently-scheduled slot across the whole preview: every
      // included course's fixed lecture(s), plus a tutorial slot for any
      // course whose time is chosen — even if its room is still pending,
      // since conflict-checking only cares about day/time, not which room.
      function allPreviewSlots(): { courseId: number; label: string; session: KindedSlot; pending: boolean }[] {
        const slots: { courseId: number; label: string; session: KindedSlot; pending: boolean }[] = [];
        for (const [courseId, entry] of preview) {
          const course = courseById.get(courseId)!;
          for (const lecture of course.sessions.filter((s) => s.kind === "lecture")) {
            slots.push({
              courseId,
              label: `${course.code} ${lecture.label}`,
              session: { dayOfWeek: lecture.dayOfWeek, startMinutes: lecture.startMinutes, endMinutes: lecture.endMinutes, kind: "lecture" },
              pending: false,
            });
          }
          if (entry.dayOfWeek != null && entry.startMinutes != null && entry.endMinutes != null) {
            const chosen = entry.sessionId != null ? course.sessions.find((s) => s.id === entry.sessionId) : undefined;
            slots.push({
              courseId,
              label: chosen ? `${course.code} ${chosen.label}` : `${course.code} tutorial (room pending)`,
              session: { dayOfWeek: entry.dayOfWeek, startMinutes: entry.startMinutes, endMinutes: entry.endMinutes, kind: "tutorial" },
              pending: entry.sessionId == null,
            });
          }
        }
        return slots;
      }

      // Same slots as above but excluding one course entirely — what a
      // not-yet-chosen tutorial option for that course would be compared
      // against, so a course never "conflicts with itself".
      function lockedSlotsExcept(exceptCourseId: number): { label: string; session: KindedSlot }[] {
        return allPreviewSlots()
          .filter((s) => s.courseId !== exceptCourseId)
          .map(({ label, session }) => ({ label, session }));
      }

      function renderScheduleList() {
        const entries = [...candidates.entries()];
        scheduleListEl.innerHTML = entries
          .map(([courseId, c]) => {
            const course = courseById.get(courseId)!;
            const inPreview = preview.has(courseId);
            const tutorials = course.sessions.filter((s) => s.kind === "tutorial");
            const options = groupTutorialTimeOptions(tutorials);
            const entry = preview.get(courseId);

            let optionsHtml = "";
            if (inPreview) {
              if (options.length === 0) {
                optionsHtml = "<p>This course has no tutorials to choose from.</p>";
              } else {
                const locked = lockedSlotsExcept(courseId);
                optionsHtml = options
                  .map((option, index) => {
                    const key = `${option.dayOfWeek}:${option.startMinutes}:${option.endMinutes}`;
                    const checked = entry?.dayOfWeek === option.dayOfWeek && entry.startMinutes === option.startMinutes && entry.endMinutes === option.endMinutes;
                    const optionSlot: KindedSlot = { dayOfWeek: option.dayOfWeek, startMinutes: option.startMinutes, endMinutes: option.endMinutes, kind: "tutorial" };
                    const tutorialClashes: string[] = [];
                    const lectureNotes: string[] = [];
                    for (const slot of locked) {
                      const cls = classifyOverlap(optionSlot, slot.session);
                      if (cls === "tutorial-clash") tutorialClashes.push(slot.label);
                      else if (cls === "lecture-note") lectureNotes.push(slot.label);
                    }
                    const notesHtml = [
                      tutorialClashes.length > 0
                        ? `<span class="conflict-note">Clashes with ${tutorialClashes.map((c) => `"${esc(c)}"`).join(", ")} in your current preview</span>`
                        : "",
                      lectureNotes.length > 0
                        ? `<span class="lecture-hint">Overlaps a lecture in your current preview (fine — available via recording): ${lectureNotes.map((c) => `"${esc(c)}"`).join(", ")}</span>`
                        : "",
                      tutorialClashes.length === 0 && lectureNotes.length === 0 ? '<span class="ok-note">No conflict with your current preview</span>' : "",
                    ].join(" ");

                    let roomHtml = "";
                    if (checked && option.sections.length > 1) {
                      const chosenSessionId = entry?.sessionId ?? null;
                      roomHtml = `<fieldset class="room-picker">
                        <legend>${chosenSessionId == null ? '<span class="incomplete-note">Time scheduled — choose a room to finish scheduling this tutorial</span>' : "Room"}</legend>
                        ${option.sections
                          .map(
                            (s) =>
                              `<label class="room-option"><input type="radio" class="room-radio" name="room-${courseId}-${index}" data-course-id="${courseId}" data-session-id="${s.id}" data-time-key="${key}" ${chosenSessionId === s.id ? "checked" : ""} /> ${esc(s.label)} — ${esc(s.location)}</label>`,
                          )
                          .join("")}
                      </fieldset>`;
                    } else if (checked && option.sections.length === 1) {
                      roomHtml = `<p class="ok-note">Room: ${esc(option.sections[0].location)}</p>`;
                    }

                    return `<label class="tutorial-option">
                        <input type="radio" class="tutorial-radio" name="tutorial-${courseId}" data-course-id="${courseId}" data-time-key="${key}" data-day="${option.dayOfWeek}" data-start="${option.startMinutes}" data-end="${option.endMinutes}" ${checked ? "checked" : ""} />
                        ${fmtSession(option)}${option.sections.length > 1 ? " (multiple rooms)" : ""} ${notesHtml}
                      </label>${roomHtml}`;
                  })
                  .join("");
              }
            }

            return `<article class="schedule-card" data-course-id="${courseId}">
              <h3>${esc(course.code)} ${c.required ? '<span class="badge">Required</span>' : ""}</h3>
              <label class="preview-toggle">
                <input type="checkbox" class="preview-include-checkbox" data-course-id="${courseId}" ${inPreview ? "checked" : ""} />
                Include in current preview
              </label>
              ${inPreview ? `<fieldset class="tutorial-options"><legend>Tutorial time</legend>${optionsHtml}</fieldset>` : ""}
            </article>`;
          })
          .join("");
      }

      function renderConflictBanners() {
        const slots = allPreviewSlots();
        const tutorialClashPairs: [string, string][] = [];
        const lectureNotePairs: [string, string][] = [];
        for (let i = 0; i < slots.length; i++) {
          for (let j = i + 1; j < slots.length; j++) {
            const cls = classifyOverlap(slots[i].session, slots[j].session);
            if (cls === "tutorial-clash") tutorialClashPairs.push([slots[i].label, slots[j].label]);
            else if (cls === "lecture-note") lectureNotePairs.push([slots[i].label, slots[j].label]);
          }
        }
        const parts: string[] = [];
        for (const [a, b] of tutorialClashPairs) {
          parts.push(`<p class="conflict-note">Tutorial clash in your current preview: "${esc(a)}" overlaps with "${esc(b)}". Change one of these two tutorial times to clear it.</p>`);
        }
        for (const [a, b] of lectureNotePairs) {
          parts.push(`<p class="lecture-hint">Lecture overlap in your current preview: "${esc(a)}" overlaps with "${esc(b)}" — this never blocks your plan, since a lecture can always be caught up on as a recording.</p>`);
        }
        conflictBannersEl.innerHTML = parts.join("");
      }

      function renderWeeklyGrid() {
        const slots = allPreviewSlots();
        if (slots.length === 0) {
          previewEmptyNote.hidden = false;
          weeklyGridEl.hidden = true;
          return;
        }
        previewEmptyNote.hidden = true;
        weeklyGridEl.hidden = false;

        const blockingIndices = new Set<number>();
        const lectureHintIndices = new Set<number>();
        for (let i = 0; i < slots.length; i++) {
          for (let j = i + 1; j < slots.length; j++) {
            const cls = classifyOverlap(slots[i].session, slots[j].session);
            if (cls === "tutorial-clash") {
              blockingIndices.add(i);
              blockingIndices.add(j);
            } else if (cls === "lecture-note") {
              lectureHintIndices.add(i);
              lectureHintIndices.add(j);
            }
          }
        }

        weeklyGridEl.innerHTML = DAY_NAMES.map((name, day) => {
          const dayIndices = slots
            .map((s, i) => ({ s, i }))
            .filter(({ s }) => s.session.dayOfWeek === day)
            .sort((a, b) => a.s.session.startMinutes - b.s.session.startMinutes);
          const items = dayIndices
            .map(({ s, i }) => {
              const classes = [
                "session-block",
                s.session.kind,
                s.pending ? "pending" : "",
                blockingIndices.has(i) ? "conflict" : "",
                lectureHintIndices.has(i) ? "lecture-hint-block" : "",
              ]
                .filter(Boolean)
                .join(" ");
              const text = `${s.label} (${fmtTime(s.session.startMinutes)}–${fmtTime(s.session.endMinutes)})`;
              return `<p class="${classes}">${esc(text)}</p>`;
            })
            .join("");
          return `<div class="day-column"><h4>${name}</h4>${items || '<p class="empty-day">No sessions</p>'}</div>`;
        }).join("");
      }

      function renderAll() {
        renderScheduleList();
        renderConflictBanners();
        renderWeeklyGrid();
        savePreviewToStorage();
      }

      scheduleListEl.addEventListener("change", (event) => {
        const target = event.target as HTMLInputElement;
        const courseId = Number(target.dataset.courseId);
        if (!courseId) return;
        if (target.classList.contains("preview-include-checkbox")) {
          if (target.checked) preview.set(courseId, { dayOfWeek: null, startMinutes: null, endMinutes: null, sessionId: null });
          else preview.delete(courseId);
          renderAll();
        } else if (target.classList.contains("tutorial-radio")) {
          const dayOfWeek = Number(target.dataset.day);
          const startMinutes = Number(target.dataset.start);
          const endMinutes = Number(target.dataset.end);
          const course = courseById.get(courseId)!;
          const options = groupTutorialTimeOptions(course.sessions.filter((s) => s.kind === "tutorial"));
          const option = options.find((o) => o.dayOfWeek === dayOfWeek && o.startMinutes === startMinutes && o.endMinutes === endMinutes)!;
          preview.set(courseId, {
            dayOfWeek,
            startMinutes,
            endMinutes,
            sessionId: option.sections.length === 1 ? option.sections[0].id : null,
          });
          renderAll();
        } else if (target.classList.contains("room-radio")) {
          const sessionId = Number(target.dataset.sessionId);
          const entry = preview.get(courseId);
          if (entry) preview.set(courseId, { ...entry, sessionId });
          renderAll();
        }
      });

      // Re-render once from the same embedded data the server used (after
      // reconciling the restored preview above), so the JS-driven view
      // starts consistent with what was already server-rendered before any
      // interaction happens.
      renderAll();
    </script>
  </body>
</html>
