---
// Phase 3 (page split + manual scheduling): MyTimetable-style layout — a
// compact left list of candidates you schedule from, and a large weekly grid
// on the right that updates the moment you change anything. Adding/removing
// candidates and the required flag now live on /courses/; this page only
// reads the candidate list (server truth) to build the left panel from.
//
// The preview itself (which candidates are "in" this visit, which tutorial
// time/room each has) is still never persisted server-side — PLAN.md/
// CLAUDE.md require it to start empty on a first visit and never silently
// become the confirmed enrolment. What's new this round: it now survives
// navigating to /courses/ and back, via sessionStorage (see the client
// script), reconciled on load against whichever courses are still actual
// candidates — so removing a candidate on /courses/ can never leave a ghost
// entry in a stale preview.
import { getPreferences, listCandidates, listConfirmedEnrollments, listCourses } from "../lib/db";
import WeeklyGridSkeleton from "../components/WeeklyGridSkeleton.astro";
import "../styles.css";

const courses = listCourses();
const candidates = listCandidates();
const confirmed = listConfirmedEnrollments();
const preferences = getPreferences();

const DAY_NAMES = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
const DAY_ABBR = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

function pad(n: number): string {
  return String(n).padStart(2, "0");
}
function fmtTime(minutes: number): string {
  return `${pad(Math.floor(minutes / 60))}:${pad(minutes % 60)}`;
}
function fmtSession(s: { dayOfWeek: number; startMinutes: number; endMinutes: number }): string {
  return `${DAY_NAMES[s.dayOfWeek]} ${fmtTime(s.startMinutes)}–${fmtTime(s.endMinutes)}`;
}

// Embedded as the client script's only source of truth for course/session
// data and the persisted candidate list, so the JS re-render it does on load
// can never drift from what the server actually has. `<script type=
// "application/json">` is a raw-text element, so this needs manual escaping
// of "</" rather than Astro's default HTML-entity escaping (which would
// corrupt the JSON).
const plannerDataJson = JSON.stringify({
  courses,
  candidates: candidates.map((c) => ({ courseId: c.courseId, required: c.required === 1 })),
  preferences,
  // Only the id pair — the client already has every course's full session
  // list (courseById), so it looks up the tutorial's label/time/location
  // from there rather than duplicating it here. Using the full course
  // catalogue (not just candidates) for that lookup is what lets a
  // confirmed course survive being removed as a candidate: its own row and
  // sessions are still in `courses`, just no longer selectable as a
  // preview/candidate entry (see the client's "no longer a candidate"
  // handling in loadConfirmedIntoPreview).
  confirmed: confirmed.map((e) => ({ courseId: e.courseId, tutorialSessionId: e.tutorialSessionId })),
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Planner (demo) — COMP4020 prototype</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Home</a>
      <a href="/courses/">Courses</a>
      <a href="/planner/">Planner</a>
      <a href="/readme/">About</a>
    </nav>
    <main class="planner">
      <h1>Planner</h1>

      <p class="disclaimer" role="note">
        <strong>Prototype, not an official ANU service.</strong> This is a student-built
        course-planning tool for a COMP4020 assignment — it is not Programs and Courses, ANUHub
        or Timetable, and never contacts any real ANU system. Every course, course code and
        session time on this page is fictional demo data. There is no login: everyone who opens
        this page is viewing and editing the same single demo student's saved candidates and
        confirmed enrolment. Lectures are always shown but never block a plan here — this
        prototype assumes a lecture can always be caught up on as a recording; only a clash
        between two tutorials actually blocks anything.
      </p>

      <section aria-labelledby="candidates-heading" class="planner-layout">
        <div class="planner-left">
          <h2 id="candidates-heading">Your candidates</h2>
          <p>
            Tick a candidate to add it to your current preview below, then pick a tutorial time
            (and a room, if that time has more than one). Add or remove candidates on the{" "}
            <a href="/courses/">courses page</a>.
          </p>
          <p id="candidates-empty-note" hidden={candidates.length > 0}>
            You don't have any candidates yet — add some on the <a href="/courses/">courses page</a>{" "}
            first.
          </p>
          <div id="candidate-schedule-list">
            {
              // Server-rendered as "nothing chosen yet" for every candidate —
              // exactly what an empty preview looks like, since the preview
              // itself only exists client-side (sessionStorage). The client
              // script re-renders this same list immediately on load once it
              // knows the real (reconciled) preview state; until JS runs, a
              // reader still sees every candidate and an honest starting
              // point rather than a blank div.
              candidates.map((c) => (
                <article class="schedule-card" data-course-id={c.courseId}>
                  <div class="schedule-card-summary">
                    <label class="preview-toggle">
                      <input type="checkbox" class="preview-include-checkbox" data-course-id={c.courseId} />
                      <span class="preview-toggle-label">In preview</span>
                    </label>
                    <span class="course-code">{c.course.code}</span>
                    {c.required === 1 && <span class="badge">Required</span>}
                  </div>
                </article>
              ))
            }
          </div>
          <div id="conflict-banners" role="status" aria-live="polite"></div>
        </div>
        <div class="planner-right">
          <h2>Weekly grid</h2>
          <p id="preview-empty-note">
            Nothing is in your current preview yet. Tick a candidate on the left to add it.
          </p>
          <p id="out-of-range-warning" class="conflict-note" role="status" aria-live="polite" hidden></p>
          <WeeklyGridSkeleton gridId="weekly-grid" dayTabsId="day-tabs" ariaLabel="Choose a day to view" hidden={true} />
          <div id="session-detail" class="session-detail" role="dialog" aria-label="Session detail" hidden></div>
        </div>
      </section>

      <section aria-labelledby="autoschedule-heading" class="autoschedule">
        <h2 id="autoschedule-heading">Auto-schedule (optional)</h2>
        <p>
          Manual scheduling above always works on its own — everything here is an optional helper
          that searches for you and only ever changes your preview when you explicitly click
          "Apply to current preview" below. Nothing here touches your confirmed enrolment.
        </p>

        <fieldset id="preferences-panel" class="preferences-panel">
          <legend>Conditions and preferences</legend>
          <p class="preferences-note">
            These are saved for you and restored if you reload this page. <strong>Days you can't
            attend</strong> are a hard rule — a plan that puts a tutorial there is never offered.
            The other two are soft: they only change which plans are shown first, and are only
            applied when you've actually set them (an empty avoid-days list, or the checkbox left
            off, has no effect on ordering). All three — and the "days on campus" count shown on
            each result — count <strong>tutorials only</strong>. A lecture never counts as a day
            on campus and is never blocked by a blackout or avoid day, since a lecture here can
            always be caught up on as a recording.
          </p>

          <fieldset class="day-checkbox-group">
            <legend>Days I can't attend (hard)</legend>
            {
              DAY_NAMES.map((name, day) => (
                <label class="day-checkbox">
                  <input
                    type="checkbox"
                    class="blackout-day-checkbox"
                    data-day={day}
                    checked={preferences.blackoutDays.includes(day)}
                  />
                  {DAY_ABBR[day]}
                  <span class="sr-only">{name}</span>
                </label>
              ))
            }
          </fieldset>

          <fieldset class="day-checkbox-group">
            <legend>Days to avoid if possible (soft)</legend>
            {
              DAY_NAMES.map((name, day) => (
                <label class="day-checkbox">
                  <input
                    type="checkbox"
                    class="avoid-day-checkbox"
                    data-day={day}
                    checked={preferences.softPreferences.avoidDays.includes(day)}
                  />
                  {DAY_ABBR[day]}
                  <span class="sr-only">{name}</span>
                </label>
              ))
            }
          </fieldset>

          <label class="minimize-days-toggle">
            <input
              type="checkbox"
              id="minimize-days-checkbox"
              checked={preferences.softPreferences.minimizeDaysOnCampus}
            />
            Prefer fewer days on campus (soft)
          </label>

          <fieldset class="desired-count-group">
            <legend>When generating a plan from candidates, aim for</legend>
            <label>
              <input type="radio" name="desired-count" value="3" checked={preferences.desiredCourseCount === 3} />
              3 courses
            </label>
            <label>
              <input type="radio" name="desired-count" value="4" checked={preferences.desiredCourseCount === 4} />
              4 courses
            </label>
          </fieldset>

          <p id="preferences-status" role="status" aria-live="polite"></p>
        </fieldset>

        <div class="autoschedule-triggers">
          <button type="button" id="generate-preview-times-btn">
            Auto-schedule tutorial times for my current preview
          </button>
          <p class="trigger-note">
            Keeps exactly the courses currently in your preview and only searches tutorial times —
            not limited to 3 or 4 courses. Won't overwrite your preview until you apply a result.
          </p>
          <button type="button" id="generate-from-candidates-btn">
            Generate a plan from my candidates
          </button>
          <p class="trigger-note">
            Aims for the course count set above, always including candidates you've marked
            required, and fills any remaining slots from your other candidates.
          </p>
        </div>

        <section id="generate-results" class="generate-results" hidden aria-labelledby="generate-results-heading">
          <h3 id="generate-results-heading"></h3>
          <p id="generate-results-summary"></p>
          <div id="generate-results-body"></div>
          <div id="generate-results-pagination" class="generate-results-pagination"></div>
          <button type="button" id="generate-results-cancel">Cancel</button>
        </section>

        <div id="plan-detail-modal" class="plan-detail-modal" role="dialog" aria-label="Plan weekly schedule" hidden>
          <button type="button" id="plan-detail-close" class="session-detail-close" aria-label="Close">×</button>
          <h4>Weekly schedule for this plan</h4>
          <p class="trigger-note">
            This is a read-only look at the plan — it never changes your current preview above.
            Only "Apply to current preview" does that.
          </p>
          <p id="plan-detail-pending-note" class="lecture-hint" hidden>
            One or more tutorial times below still need a specific room/section chosen — shown as
            "To be chosen" until you apply this plan and pick one.
          </p>
          <p id="plan-detail-out-of-range-warning" class="conflict-note" role="status" aria-live="polite" hidden></p>
          <WeeklyGridSkeleton
            gridId="plan-detail-grid"
            dayTabsId="plan-detail-day-tabs"
            ariaLabel="Choose a day to view for this plan"
          />
          <div id="plan-detail-session-detail" class="session-detail" role="dialog" aria-label="Plan session detail" hidden></div>
          <details id="plan-detail-list-details">
            <summary>Show as a day-by-day list instead (useful on a small screen)</summary>
            <div id="plan-detail-content"></div>
          </details>
        </div>
      </section>

      <section aria-labelledby="confirm-heading" class="confirm-section">
        <h2 id="confirm-heading">Confirm your preview</h2>
        <p>
          Confirming replaces your <strong>whole</strong> saved enrolment below with exactly the
          courses and tutorial times currently in your preview above. This only ever writes to
          this prototype's own demo database, for the same single demo student — it never
          contacts ANUHub, Programs and Courses, Timetable or any other real ANU system, and
          nothing here is a real enrolment action.
        </p>
        <p id="confirm-blocked-note" class="conflict-note" role="status" aria-live="polite" hidden></p>
        <button type="button" id="confirm-enrolment-btn">Review and confirm enrolment</button>
        <p id="confirm-status" role="status" aria-live="polite"></p>

        <div id="confirm-dialog" class="confirm-dialog" role="dialog" aria-label="Confirm enrolment" hidden>
          <h3>Confirm this enrolment?</h3>
          <p>
            This replaces your whole confirmed enrolment with the plan below. It's still only a
            write to this prototype's own demo database — not a real ANU enrolment action, and
            nothing is sent to any real ANU system.
          </p>
          <div id="confirm-dialog-diff"></div>
          <p id="confirm-dialog-error" class="conflict-note" role="alert" hidden></p>
          <div class="confirm-dialog-actions">
            <button type="button" id="confirm-dialog-confirm">Yes, confirm enrolment</button>
            <button type="button" id="confirm-dialog-cancel">Cancel</button>
          </div>
        </div>
      </section>

      <section aria-labelledby="confirmed-heading">
        <h2 id="confirmed-heading">Your confirmed enrolment</h2>
        <p>
          What's actually saved for this demo student, kept separate from the preview above — it
          only ever changes when you confirm (above) or withdraw a course (below), both of which
          only ever write to this prototype's own demo database, never a real ANU system.
        </p>
        <p id="confirmed-empty-note" hidden={confirmed.length > 0}>
          You don't have a confirmed enrolment yet.
        </p>
        <ul id="confirmed-list" hidden={confirmed.length === 0}>
          {
            confirmed.map((e) => (
              <li data-course-id={e.courseId}>
                <span class="course-code">{e.course.code}</span> — tutorial {e.tutorialSession.label}:{" "}
                {fmtSession(e.tutorialSession)} — {e.tutorialSession.location}
                <button
                  type="button"
                  class="withdraw-course-btn"
                  data-course-id={e.courseId}
                  data-course-code={e.course.code}
                >
                  Withdraw
                </button>
              </li>
            ))
          }
        </ul>
        <div class="confirmed-actions">
          <button type="button" id="load-confirmed-into-preview-btn" disabled={confirmed.length === 0}>
            Edit in preview
          </button>
          <p class="trigger-note">
            Loads these courses and tutorial times into your preview above so you can change
            something and confirm again — this is also how you swap one confirmed course for
            another. Never happens silently: you'll always see exactly what's about to be loaded
            first.
          </p>
        </div>

        <div
          id="load-preview-dialog"
          class="confirm-dialog"
          role="dialog"
          aria-label="Load confirmed enrolment into preview"
          hidden
        >
          <h3>Load your confirmed enrolment into the preview?</h3>
          <div id="load-preview-dialog-body"></div>
          <div class="confirm-dialog-actions">
            <button type="button" id="load-preview-dialog-confirm">Yes, load into preview</button>
            <button type="button" id="load-preview-dialog-cancel">Cancel</button>
          </div>
        </div>

        <div id="withdraw-dialog" class="confirm-dialog" role="dialog" aria-label="Withdraw course" hidden>
          <h3>Withdraw <span id="withdraw-dialog-course"></span>?</h3>
          <p>
            This removes it from your confirmed enrolment only. It stays in your candidates list
            (and in your preview, if it's there) unless you remove it separately on the{" "}
            <a href="/courses/">courses page</a>.
          </p>
          <p id="withdraw-dialog-error" class="conflict-note" role="alert" hidden></p>
          <div class="confirm-dialog-actions">
            <button type="button" id="withdraw-dialog-confirm">Yes, withdraw</button>
            <button type="button" id="withdraw-dialog-cancel">Cancel</button>
          </div>
        </div>
      </section>
    </main>
    <script type="application/json" id="planner-data" set:html={plannerDataJson} />
    <script>
      import {
        type KindedSlot,
        classifyOverlap,
        computeGridPosition,
        groupTutorialTimeOptions,
        packOverlappingSlots,
      } from "../lib/scheduling";

      type SessionRow = { id: number; kind: "lecture" | "tutorial"; label: string; dayOfWeek: number; startMinutes: number; endMinutes: number; location: string };
      type CourseRow = { id: number; code: string; title: string; sessions: SessionRow[] };

      const DAY_NAMES = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
      const DAY_ABBR = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
      const pad = (n: number) => String(n).padStart(2, "0");
      const fmtTime = (m: number) => `${pad(Math.floor(m / 60))}:${pad(m % 60)}`;
      const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

      type PreferencesState = {
        desiredCourseCount: number;
        blackoutDays: number[];
        softPreferences: { minimizeDaysOnCampus: boolean; avoidDays: number[] };
      };

      type EnrollmentChoice = { courseId: number; tutorialSessionId: number };

      const dataEl = document.getElementById("planner-data");
      const data = JSON.parse(dataEl?.textContent ?? "{}") as {
        courses: CourseRow[];
        candidates: { courseId: number; required: boolean }[];
        preferences: PreferencesState;
        confirmed: EnrollmentChoice[];
      };

      const courses: CourseRow[] = data.courses ?? [];
      const courseById = new Map(courses.map((c) => [c.id, c]));
      // courseId -> required. Presence in this map means "is a candidate" —
      // the persisted, server-truth state this page's left panel is built
      // from (this page never mutates it; that only happens on /courses/).
      const candidates = new Map<number, { required: boolean }>((data.candidates ?? []).map((c) => [c.courseId, { required: c.required }]));

      // Server-persisted conditions/preferences (Phase 4) — restored on load
      // from the same server-rendered data the checkboxes below start
      // checked from, then kept in sync with whatever was last successfully
      // saved via PUT /api/preferences. Used both to build the request body
      // for auto-schedule mode "candidates" (indirectly — the server reads
      // its own copy) and, client-side, as part of the "have the inputs to a
      // past generate call changed since" staleness key.
      let preferencesState: PreferencesState = data.preferences ?? {
        desiredCourseCount: 3,
        blackoutDays: [],
        softPreferences: { minimizeDaysOnCampus: false, avoidDays: [] },
      };

      // Client-only preview: courseId -> chosen time/room, or "in preview but
      // nothing chosen yet" (dayOfWeek === null). Never sent to the server,
      // never touches candidates or confirmed enrolment. Persisted to
      // sessionStorage so it survives a trip to /courses/ and back, but nowhere
      // else — closing the tab or opening a new one starts fresh, matching the
      // "never needs to survive a reload" rule for a *single* visit's browser
      // session PLAN.md/CLAUDE.md set out, just extended across this app's own
      // two pages rather than one.
      type PreviewEntry = { dayOfWeek: number | null; startMinutes: number | null; endMinutes: number | null; sessionId: number | null };
      const PREVIEW_STORAGE_KEY = "planner-preview-v1";

      function loadPreviewFromStorage(): Map<number, PreviewEntry> {
        try {
          const raw = sessionStorage.getItem(PREVIEW_STORAGE_KEY);
          if (!raw) return new Map();
          const parsed = JSON.parse(raw) as [number, PreviewEntry][];
          if (!Array.isArray(parsed)) return new Map();
          return new Map(parsed);
        } catch {
          return new Map();
        }
      }

      function savePreviewToStorage() {
        try {
          sessionStorage.setItem(PREVIEW_STORAGE_KEY, JSON.stringify([...preview.entries()]));
        } catch {
          // sessionStorage can throw (private browsing, quota) — the preview
          // still works for this page view, it just won't survive a
          // navigation. Not worth surfacing as an error to the visitor.
        }
      }

      const preview = loadPreviewFromStorage();

      // Reconcile the restored preview against the *current* candidate list
      // and course data before rendering anything: drop any course that's no
      // longer a candidate (removed on /courses/ since this preview was
      // saved), and re-validate any chosen time/room still actually exists —
      // falling back to "time chosen, room pending" or "nothing chosen yet"
      // rather than pointing at a session id that no longer exists.
      for (const courseId of [...preview.keys()]) {
        const course = courseById.get(courseId);
        if (!candidates.has(courseId) || !course) {
          preview.delete(courseId);
          continue;
        }
        const entry = preview.get(courseId)!;
        if (entry.dayOfWeek == null) continue;
        const options = groupTutorialTimeOptions(course.sessions.filter((s) => s.kind === "tutorial"));
        const match = options.find((o) => o.dayOfWeek === entry.dayOfWeek && o.startMinutes === entry.startMinutes && o.endMinutes === entry.endMinutes);
        if (!match) {
          preview.set(courseId, { dayOfWeek: null, startMinutes: null, endMinutes: null, sessionId: null });
        } else if (entry.sessionId != null && !match.sections.some((s) => s.id === entry.sessionId)) {
          preview.set(courseId, {
            dayOfWeek: match.dayOfWeek,
            startMinutes: match.startMinutes,
            endMinutes: match.endMinutes,
            sessionId: match.sections.length === 1 ? match.sections[0].id : null,
          });
        }
      }
      savePreviewToStorage();

      // Server-persisted confirmed enrolment (PLAN.md's third state). Starts
      // from what the server rendered this page with, then is only ever
      // replaced wholesale (on a successful confirm) or trimmed by one
      // course (on a successful withdraw) — a failed request leaves it, and
      // therefore what's shown, exactly as it was.
      let confirmedState: EnrollmentChoice[] = [...(data.confirmed ?? [])];

      const scheduleListEl = document.getElementById("candidate-schedule-list")!;
      const conflictBannersEl = document.getElementById("conflict-banners")!;
      const previewEmptyNote = document.getElementById("preview-empty-note")!;
      const weeklyGridEl = document.getElementById("weekly-grid")!;
      const outOfRangeWarningEl = document.getElementById("out-of-range-warning")!;
      const sessionDetailEl = document.getElementById("session-detail")!;
      const dayTabsEl = document.getElementById("day-tabs")!;

      const preferencesPanelEl = document.getElementById("preferences-panel")!;
      const preferencesStatusEl = document.getElementById("preferences-status")!;
      const generatePreviewTimesBtn = document.getElementById("generate-preview-times-btn") as HTMLButtonElement;
      const generateFromCandidatesBtn = document.getElementById("generate-from-candidates-btn") as HTMLButtonElement;
      const generateResultsEl = document.getElementById("generate-results")!;
      const generateResultsHeadingEl = document.getElementById("generate-results-heading")!;
      const generateResultsSummaryEl = document.getElementById("generate-results-summary")!;
      const generateResultsBodyEl = document.getElementById("generate-results-body")!;
      const generateResultsPaginationEl = document.getElementById("generate-results-pagination")!;
      const generateResultsCancelBtn = document.getElementById("generate-results-cancel") as HTMLButtonElement;
      const planDetailModalEl = document.getElementById("plan-detail-modal")!;
      const planDetailCloseBtn = document.getElementById("plan-detail-close") as HTMLButtonElement;
      const planDetailContentEl = document.getElementById("plan-detail-content")!;
      const planDetailPendingNoteEl = document.getElementById("plan-detail-pending-note")!;
      const planDetailOutOfRangeEl = document.getElementById("plan-detail-out-of-range-warning")!;
      const planDetailGridEl = document.getElementById("plan-detail-grid")!;
      const planDetailDayTabsEl = document.getElementById("plan-detail-day-tabs")!;
      const planDetailSessionDetailEl = document.getElementById("plan-detail-session-detail")!;

      const confirmBlockedNoteEl = document.getElementById("confirm-blocked-note")!;
      const confirmEnrolmentBtn = document.getElementById("confirm-enrolment-btn") as HTMLButtonElement;
      const confirmStatusEl = document.getElementById("confirm-status")!;
      const confirmDialogEl = document.getElementById("confirm-dialog")!;
      const confirmDialogDiffEl = document.getElementById("confirm-dialog-diff")!;
      const confirmDialogErrorEl = document.getElementById("confirm-dialog-error")!;
      const confirmDialogConfirmBtn = document.getElementById("confirm-dialog-confirm") as HTMLButtonElement;
      const confirmDialogCancelBtn = document.getElementById("confirm-dialog-cancel") as HTMLButtonElement;

      const confirmedEmptyNoteEl = document.getElementById("confirmed-empty-note")!;
      const confirmedListEl = document.getElementById("confirmed-list")!;
      const loadConfirmedBtn = document.getElementById("load-confirmed-into-preview-btn") as HTMLButtonElement;
      const loadPreviewDialogEl = document.getElementById("load-preview-dialog")!;
      const loadPreviewDialogBodyEl = document.getElementById("load-preview-dialog-body")!;
      const loadPreviewDialogConfirmBtn = document.getElementById("load-preview-dialog-confirm") as HTMLButtonElement;
      const loadPreviewDialogCancelBtn = document.getElementById("load-preview-dialog-cancel") as HTMLButtonElement;
      const withdrawDialogEl = document.getElementById("withdraw-dialog")!;
      const withdrawDialogCourseEl = document.getElementById("withdraw-dialog-course")!;
      const withdrawDialogErrorEl = document.getElementById("withdraw-dialog-error")!;
      const withdrawDialogConfirmBtn = document.getElementById("withdraw-dialog-confirm") as HTMLButtonElement;
      const withdrawDialogCancelBtn = document.getElementById("withdraw-dialog-cancel") as HTMLButtonElement;

      type PreviewSlot = { courseId: number; label: string; session: KindedSlot; location: string; pending: boolean };

      // Every currently-scheduled slot across the whole preview: every
      // included course's fixed lecture(s), plus a tutorial slot for any
      // course whose time is chosen — even if its room is still pending,
      // since conflict-checking only cares about day/time, not which room.
      // `location` is carried through purely for the grid's click-to-expand
      // detail panel (requirement: block text stays compact, room/section
      // detail is a click away) — it was already part of each session row,
      // just not previously threaded through this function.
      function allPreviewSlots(): PreviewSlot[] {
        const slots: PreviewSlot[] = [];
        for (const [courseId, entry] of preview) {
          const course = courseById.get(courseId)!;
          for (const lecture of course.sessions.filter((s) => s.kind === "lecture")) {
            slots.push({
              courseId,
              label: `${course.code} ${lecture.label}`,
              session: { dayOfWeek: lecture.dayOfWeek, startMinutes: lecture.startMinutes, endMinutes: lecture.endMinutes, kind: "lecture" },
              location: lecture.location,
              pending: false,
            });
          }
          if (entry.dayOfWeek != null && entry.startMinutes != null && entry.endMinutes != null) {
            const chosen = entry.sessionId != null ? course.sessions.find((s) => s.id === entry.sessionId) : undefined;
            slots.push({
              courseId,
              label: chosen ? `${course.code} ${chosen.label}` : `${course.code} tutorial (room pending)`,
              session: { dayOfWeek: entry.dayOfWeek, startMinutes: entry.startMinutes, endMinutes: entry.endMinutes, kind: "tutorial" },
              location: chosen ? chosen.location : "Room not yet chosen",
              pending: entry.sessionId == null,
            });
          }
        }
        return slots;
      }

      // Same slots as above but excluding one course entirely — what a
      // not-yet-chosen tutorial option for that course would be compared
      // against, so a course never "conflicts with itself".
      function lockedSlotsExcept(exceptCourseId: number): { label: string; session: KindedSlot }[] {
        return allPreviewSlots()
          .filter((s) => s.courseId !== exceptCourseId)
          .map(({ label, session }) => ({ label, session }));
      }

      // Which candidate's full tutorial/room options are shown, if any — at
      // most one at a time (an accordion, not "everything open"), which is
      // what keeps the left column compact. This is pure UI state: it never
      // reads or writes `preview`/`candidates`, and the preview-include
      // checkbox's own change handler is a separate listener on a separate
      // element, so expanding/collapsing a card can never toggle what's in
      // the preview, and checking/unchecking that box can never itself run
      // the expand-toggle's code path.
      let expandedCourseId: number | null = null;

      function renderScheduleList() {
        const entries = [...candidates.entries()];

        // Per-course "does this course's current tutorial clash with
        // anything else in the preview" flag, for the collapsed row's status
        // chip — same classifyOverlap rule the expanded option list and the
        // weekly grid use, just grouped by course instead of by slot index.
        const allSlots = allPreviewSlots();
        const courseHasClash = new Set<number>();
        for (let i = 0; i < allSlots.length; i++) {
          for (let j = i + 1; j < allSlots.length; j++) {
            if (classifyOverlap(allSlots[i].session, allSlots[j].session) === "tutorial-clash") {
              courseHasClash.add(allSlots[i].courseId);
              courseHasClash.add(allSlots[j].courseId);
            }
          }
        }

        scheduleListEl.innerHTML = entries
          .map(([courseId, c]) => {
            const course = courseById.get(courseId)!;
            const inPreview = preview.has(courseId);
            const entry = preview.get(courseId);
            const expanded = inPreview && expandedCourseId === courseId;

            let timeHtml = "";
            let statusHtml = "";
            if (inPreview) {
              if (entry?.dayOfWeek == null) {
                statusHtml = '<span class="incomplete-note">Choose a time</span>';
              } else {
                timeHtml = `<span class="current-time">${DAY_ABBR[entry.dayOfWeek]} ${fmtTime(entry.startMinutes!)}–${fmtTime(entry.endMinutes!)}</span>`;
                if (courseHasClash.has(courseId)) statusHtml = '<span class="conflict-note">Clash</span>';
                else if (entry.sessionId == null) statusHtml = '<span class="incomplete-note">Room pending</span>';
                else statusHtml = '<span class="ok-note">Scheduled</span>';
              }
            }

            // Not in preview: nothing to expand, so this is plain text, not
            // a button — there's no full-options panel a click could open.
            const summaryHtml = inPreview
              ? `<button type="button" class="schedule-card-toggle" data-course-id="${courseId}" aria-expanded="${expanded}">
                  <span class="chevron" aria-hidden="true">${expanded ? "▾" : "▸"}</span>
                  <span class="course-code">${esc(course.code)}</span>
                  ${c.required ? '<span class="badge">Required</span>' : ""}
                  ${timeHtml}
                  ${statusHtml}
                </button>`
              : `<span class="course-code">${esc(course.code)}</span>${c.required ? ' <span class="badge">Required</span>' : ""}`;

            let optionsHtml = "";
            if (expanded) {
              const tutorials = course.sessions.filter((s) => s.kind === "tutorial");
              const options = groupTutorialTimeOptions(tutorials);
              if (options.length === 0) {
                optionsHtml = "<p>This course has no tutorials to choose from.</p>";
              } else {
                const locked = lockedSlotsExcept(courseId);
                optionsHtml = options
                  .map((option, index) => {
                    const key = `${option.dayOfWeek}:${option.startMinutes}:${option.endMinutes}`;
                    const checked = entry?.dayOfWeek === option.dayOfWeek && entry.startMinutes === option.startMinutes && entry.endMinutes === option.endMinutes;
                    const optionSlot: KindedSlot = { dayOfWeek: option.dayOfWeek, startMinutes: option.startMinutes, endMinutes: option.endMinutes, kind: "tutorial" };
                    const tutorialClashes: { label: string; session: KindedSlot }[] = [];
                    const lectureNotes: { label: string; session: KindedSlot }[] = [];
                    for (const slot of locked) {
                      const cls = classifyOverlap(optionSlot, slot.session);
                      if (cls === "tutorial-clash") tutorialClashes.push(slot);
                      else if (cls === "lecture-note") lectureNotes.push(slot);
                    }
                    // "No conflict" collapses to a short word instead of a
                    // full sentence repeated on every option — but a real
                    // conflict still names the specific course and time it
                    // clashes with, never just "Clash".
                    let statusNoteHtml: string;
                    if (tutorialClashes.length > 0) {
                      statusNoteHtml = `<span class="conflict-note">Clash: ${tutorialClashes.map((s) => `"${esc(s.label)}" ${fmtTime(s.session.startMinutes)}–${fmtTime(s.session.endMinutes)}`).join(", ")}</span>`;
                    } else if (lectureNotes.length > 0) {
                      statusNoteHtml = `<span class="lecture-hint">Overlaps lecture (ok, recording available): ${lectureNotes.map((s) => `"${esc(s.label)}" ${fmtTime(s.session.startMinutes)}–${fmtTime(s.session.endMinutes)}`).join(", ")}</span>`;
                    } else {
                      statusNoteHtml = '<span class="ok-note">No conflict</span>';
                    }

                    let roomHtml = "";
                    if (checked && option.sections.length > 1) {
                      const chosenSessionId = entry?.sessionId ?? null;
                      roomHtml = `<fieldset class="room-picker">
                        <legend>${chosenSessionId == null ? '<span class="incomplete-note">Choose a room</span>' : "Room"}</legend>
                        ${option.sections
                          .map(
                            (s) =>
                              `<label class="room-option"><input type="radio" class="room-radio" name="room-${courseId}-${index}" data-course-id="${courseId}" data-session-id="${s.id}" data-time-key="${key}" ${chosenSessionId === s.id ? "checked" : ""} /> ${esc(s.label)} — ${esc(s.location)}</label>`,
                          )
                          .join("")}
                      </fieldset>`;
                    } else if (checked && option.sections.length === 1) {
                      roomHtml = `<p class="tutorial-location">${esc(option.sections[0].location)}</p>`;
                    }

                    return `<div class="tutorial-option-row">
                        <label class="tutorial-option">
                          <input type="radio" class="tutorial-radio" name="tutorial-${courseId}" data-course-id="${courseId}" data-time-key="${key}" data-day="${option.dayOfWeek}" data-start="${option.startMinutes}" data-end="${option.endMinutes}" ${checked ? "checked" : ""} />
                          <span class="option-time">${DAY_ABBR[option.dayOfWeek]} ${fmtTime(option.startMinutes)}–${fmtTime(option.endMinutes)}${option.sections.length > 1 ? " (multi-room)" : ""}</span>
                          ${statusNoteHtml}
                        </label>
                        ${roomHtml}
                      </div>`;
                  })
                  .join("");
              }
            }

            return `<article class="schedule-card" data-course-id="${courseId}">
              <div class="schedule-card-summary">
                <label class="preview-toggle">
                  <input type="checkbox" class="preview-include-checkbox" data-course-id="${courseId}" ${inPreview ? "checked" : ""} />
                  <span class="preview-toggle-label">In preview</span>
                </label>
                ${summaryHtml}
              </div>
              ${expanded ? `<fieldset class="tutorial-options"><legend>Tutorial time</legend>${optionsHtml}</fieldset>` : ""}
            </article>`;
          })
          .join("");
      }

      // Shared by renderConflictBanners and the confirm-blocking check below,
      // so "does this preview have a tutorial-vs-tutorial clash" is computed
      // one way, not two — a lecture-involving overlap is always
      // "lecture-note" (never blocking), per classifyOverlap.
      function computePreviewOverlaps(slots: PreviewSlot[]) {
        const tutorialClashPairs: [string, string][] = [];
        const lectureNotePairs: [string, string][] = [];
        for (let i = 0; i < slots.length; i++) {
          for (let j = i + 1; j < slots.length; j++) {
            const cls = classifyOverlap(slots[i].session, slots[j].session);
            if (cls === "tutorial-clash") tutorialClashPairs.push([slots[i].label, slots[j].label]);
            else if (cls === "lecture-note") lectureNotePairs.push([slots[i].label, slots[j].label]);
          }
        }
        return { tutorialClashPairs, lectureNotePairs };
      }

      function renderConflictBanners() {
        const slots = allPreviewSlots();
        const { tutorialClashPairs, lectureNotePairs } = computePreviewOverlaps(slots);
        const parts: string[] = [];
        for (const [a, b] of tutorialClashPairs) {
          parts.push(`<p class="conflict-note">Tutorial clash in your current preview: "${esc(a)}" overlaps with "${esc(b)}". Change one of these two tutorial times to clear it.</p>`);
        }
        for (const [a, b] of lectureNotePairs) {
          parts.push(`<p class="lecture-hint">Lecture overlap in your current preview: "${esc(a)}" overlaps with "${esc(b)}" — this never blocks your plan, since a lecture can always be caught up on as a recording.</p>`);
        }
        conflictBannersEl.innerHTML = parts.join("");
      }

      // Short, fixed-width kind label so a block's own text never has to grow
      // to say "lecture"/"tutorial" in full — the block's height is always
      // just its time-proportional height, never inflated by its label.
      const KIND_ABBR: Record<KindedSlot["kind"], string> = { lecture: "Lec", tutorial: "Tut" };

      // Slots currently rendered in each grid, indexed by the same "detail
      // index" each block's data-detail-index points at, so a click can look
      // up the full label/location/status without re-deriving it from text.
      // Two separate lists (one per grid instance) so opening the plan
      // detail's grid can never look up an index into the manual preview's
      // slot list, or vice versa.
      let currentDetailSlots: PreviewSlot[] = [];
      let currentPlanDetailSlots: PreviewSlot[] = [];

      function closeDetailPanel(panelEl: HTMLElement) {
        panelEl.hidden = true;
        panelEl.innerHTML = "";
      }

      function openDetailPanel(panelEl: HTMLElement, slot: PreviewSlot, statusText: string) {
        panelEl.innerHTML = `
          <button type="button" class="session-detail-close" aria-label="Close">×</button>
          <h4>${esc(slot.label)}</h4>
          <p>${esc(KIND_ABBR[slot.session.kind] === "Lec" ? "Lecture" : "Tutorial")} · ${esc(DAY_NAMES[slot.session.dayOfWeek])} ${esc(fmtTime(slot.session.startMinutes))}–${esc(fmtTime(slot.session.endMinutes))}</p>
          <p>Location: ${esc(slot.location)}</p>
          <p>${esc(statusText)}</p>
        `;
        panelEl.hidden = false;
      }

      function closeSessionDetail() {
        closeDetailPanel(sessionDetailEl);
      }

      function detailStatusText(slot: PreviewSlot): string {
        return slot.pending
          ? "Time scheduled — room/section not yet chosen."
          : slot.session.kind === "tutorial"
            ? "Scheduled."
            : "Lecture — always available via recording, never blocks your plan.";
      }

      // Shared by both grid instances (the manual preview's own grid and the
      // generated-plan detail view): fills in each day column's session
      // blocks from a given slot list using the same overlap classification,
      // packing and 08:00-22:00 positioning either grid ever uses, so the two
      // can never draw the same kind of data two different ways. Returns
      // nothing — callers keep their own "which slots are currently shown,
      // for click-to-expand" list, since the two grids never share one.
      function renderSlotsIntoGrid(slots: PreviewSlot[], gridRootEl: HTMLElement, outOfRangeEl: HTMLElement) {
        const blockingIndices = new Set<number>();
        const lectureHintIndices = new Set<number>();
        for (let i = 0; i < slots.length; i++) {
          for (let j = i + 1; j < slots.length; j++) {
            const cls = classifyOverlap(slots[i].session, slots[j].session);
            if (cls === "tutorial-clash") {
              blockingIndices.add(i);
              blockingIndices.add(j);
            } else if (cls === "lecture-note") {
              lectureHintIndices.add(i);
              lectureHintIndices.add(j);
            }
          }
        }

        // CLAUDE.md: a session outside the fixed 08:00-22:00 axis must be
        // disclosed, never silently hidden. Fully out-of-range sessions can't
        // be drawn on the grid at all, so they're named in this banner
        // instead; a partially-clipped one is still drawn (clamped to the
        // visible window) but also named here so its true, longer time isn't
        // mistaken for what's actually on screen.
        const outOfRangeNotes: string[] = [];

        gridRootEl.querySelectorAll<HTMLElement>(".day-column").forEach((columnEl) => {
          const day = Number(columnEl.dataset.day);
          const blocksEl = columnEl.querySelector<HTMLElement>(".day-column-blocks")!;
          const dayEntries = slots
            .map((s, i) => ({ s, i }))
            .filter(({ s }) => s.session.dayOfWeek === day);

          const packed = packOverlappingSlots(dayEntries.map(({ s }) => s.session));
          const html = dayEntries
            .map(({ s, i }, entryIndex) => {
              const pos = computeGridPosition(s.session.startMinutes, s.session.endMinutes);
              if (pos.kind === "out-of-range") {
                outOfRangeNotes.push(`${s.label} (${fmtTime(s.session.startMinutes)}–${fmtTime(s.session.endMinutes)}) is outside the displayed 08:00–22:00 window and can't be shown on the grid.`);
                return "";
              }
              if (pos.clippedStart || pos.clippedEnd) {
                outOfRangeNotes.push(`${s.label} (${fmtTime(s.session.startMinutes)}–${fmtTime(s.session.endMinutes)}) extends outside 08:00–22:00; it's shown clipped to the visible window.`);
              }
              const { column, totalColumns } = packed[entryIndex];
              const classes = [
                "session-block",
                s.session.kind,
                s.pending ? "pending" : "",
                blockingIndices.has(i) ? "conflict" : "",
                lectureHintIndices.has(i) ? "lecture-hint-block" : "",
              ]
                .filter(Boolean)
                .join(" ");
              const style = `top:${pos.topPx}px;height:${pos.heightPx}px;left:calc(${column} * (100% / ${totalColumns}));width:calc(100% / ${totalColumns} - 4px);`;
              const text = `${s.label.split(" ")[0]} ${KIND_ABBR[s.session.kind]} ${fmtTime(s.session.startMinutes)}–${fmtTime(s.session.endMinutes)}`;
              return `<button type="button" class="${classes}" style="${style}" data-detail-index="${i}">${esc(text)}</button>`;
            })
            .join("");
          blocksEl.innerHTML = html || "";
        });

        if (outOfRangeNotes.length > 0) {
          outOfRangeEl.textContent = outOfRangeNotes.join(" ");
          outOfRangeEl.hidden = false;
        } else {
          outOfRangeEl.hidden = true;
          outOfRangeEl.textContent = "";
        }

        // On narrow viewports the day-tabs row shows only one day at a time,
        // and WeeklyGridSkeleton.astro defaults that to the *real* calendar
        // day — which has no relationship to this demo's fixed course days.
        // Left alone, a preview scheduled entirely on (say) Monday and
        // Wednesday looks completely empty to anyone opening the planner on
        // a Sunday. If the currently active day has nothing on it but some
        // other day does, jump to the first (Monday-first) day that actually
        // has a session, so the grid never appears empty when it isn't.
        const tabsEl = gridRootEl.querySelector<HTMLElement>(".day-tabs");
        const activeColumn = gridRootEl.querySelector<HTMLElement>(".day-column.mobile-active");
        if (tabsEl && activeColumn) {
          const daysWithSessions = new Set(slots.map((s) => s.session.dayOfWeek));
          const activeDay = Number(activeColumn.dataset.day);
          if (daysWithSessions.size > 0 && !daysWithSessions.has(activeDay)) {
            const nextDay = [0, 1, 2, 3, 4, 5, 6].find((d) => daysWithSessions.has(d))!;
            setActiveDay(tabsEl, gridRootEl, nextDay);
          }
        }
      }

      function renderWeeklyGrid() {
        // Any open detail panel refers to a slot index into the *previous*
        // render's slot list, which a re-render can invalidate (a course
        // toggled off, a different tutorial chosen) — always close it rather
        // than risk showing stale or mismatched detail after a change.
        closeSessionDetail();
        const slots = allPreviewSlots();
        if (slots.length === 0) {
          previewEmptyNote.hidden = false;
          weeklyGridEl.hidden = true;
          return;
        }
        previewEmptyNote.hidden = true;
        weeklyGridEl.hidden = false;
        currentDetailSlots = slots;
        renderSlotsIntoGrid(slots, weeklyGridEl, outOfRangeWarningEl);
      }

      weeklyGridEl.addEventListener("click", (event) => {
        const target = (event.target as HTMLElement).closest<HTMLElement>("[data-detail-index]");
        if (!target) return;
        const index = Number(target.dataset.detailIndex);
        const slot = currentDetailSlots[index];
        if (!slot) return;
        openDetailPanel(sessionDetailEl, slot, detailStatusText(slot));
      });

      sessionDetailEl.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest(".session-detail-close")) closeDetailPanel(sessionDetailEl);
      });

      planDetailGridEl.addEventListener("click", (event) => {
        const target = (event.target as HTMLElement).closest<HTMLElement>("[data-detail-index]");
        if (!target) return;
        const index = Number(target.dataset.detailIndex);
        const slot = currentPlanDetailSlots[index];
        if (!slot) return;
        openDetailPanel(planDetailSessionDetailEl, slot, detailStatusText(slot));
      });

      planDetailSessionDetailEl.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest(".session-detail-close")) closeDetailPanel(planDetailSessionDetailEl);
      });

      // Wires a day-tabs row (the mobile day-switcher) to the matching grid's
      // own day-header/day-column elements — shared by the manual preview's
      // grid and the plan-detail grid, each with its own tabs/grid pair, so
      // switching the visible day on one can never affect the other.
      function setActiveDay(tabsEl: HTMLElement, gridRootEl: HTMLElement, day: number) {
        tabsEl.querySelectorAll<HTMLButtonElement>(".day-tab").forEach((tab) => {
          const isActive = Number(tab.dataset.day) === day;
          tab.classList.toggle("mobile-active", isActive);
          tab.setAttribute("aria-selected", String(isActive));
        });
        gridRootEl.querySelectorAll<HTMLElement>(".day-header, .day-column").forEach((el) => {
          el.classList.toggle("mobile-active", Number(el.dataset.day) === day);
        });
      }

      function wireDayTabs(tabsEl: HTMLElement, gridRootEl: HTMLElement) {
        tabsEl.addEventListener("click", (event) => {
          const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".day-tab");
          if (!button) return;
          setActiveDay(tabsEl, gridRootEl, Number(button.dataset.day));
        });
      }

      wireDayTabs(dayTabsEl, weeklyGridEl);
      wireDayTabs(planDetailDayTabsEl, planDetailGridEl);

      function renderAll() {
        renderScheduleList();
        renderConflictBanners();
        renderWeeklyGrid();
        renderConfirmBlockedNote();
        savePreviewToStorage();
      }

      // --- Phase 5: confirm / view / withdraw confirmed enrolment --------

      // Turns a courseId + tutorialSessionId pair into a human-readable line
      // for diffs and dialogs. Looks the session up in `courseById`, which is
      // built from the *whole* course catalogue (not just candidates), so
      // this still resolves correctly for a confirmed course that's since
      // been removed as a candidate.
      function describeChoice(courseId: number, tutorialSessionId: number | null): string {
        const course = courseById.get(courseId);
        if (!course) return `Course ${courseId} (no longer exists)`;
        if (tutorialSessionId == null) return `${course.code} (no tutorial time chosen)`;
        const session = course.sessions.find((s) => s.id === tutorialSessionId);
        if (!session) return `${course.code} (that tutorial section no longer exists)`;
        return `${course.code} — ${session.label}: ${DAY_ABBR[session.dayOfWeek]} ${fmtTime(session.startMinutes)}–${fmtTime(session.endMinutes)} (${session.location})`;
      }

      type ConfirmPlanResult = { ok: true; choices: EnrollmentChoice[] } | { ok: false; reason: string };

      // Everything that must hold before the current preview is even
      // eligible to submit as a confirm — mirrors the backend's own checks
      // (empty, >4 courses, tutorial-vs-tutorial clash) plus the two things
      // only the client can see before submitting (a course with no time
      // chosen yet, or a chosen time whose room/section is still pending).
      // Never checks the 3/4 desired-count preference — that's mode-B-only
      // (CLAUDE.md), not a manual-preview restriction.
      function computeConfirmPlan(): ConfirmPlanResult {
        const entries = [...preview.entries()];
        if (entries.length === 0) {
          return { ok: false, reason: "Your preview is empty — add a candidate and choose a tutorial time before confirming." };
        }
        const noTime = entries.filter(([, e]) => e.dayOfWeek == null);
        if (noTime.length > 0) {
          const codes = noTime.map(([courseId]) => courseById.get(courseId)?.code ?? String(courseId)).join(", ");
          return { ok: false, reason: `Choose a tutorial time for: ${codes}.` };
        }
        const pending = entries.filter(([, e]) => e.sessionId == null);
        if (pending.length > 0) {
          const codes = pending.map(([courseId]) => courseById.get(courseId)?.code ?? String(courseId)).join(", ");
          return { ok: false, reason: `Choose a specific room/section for: ${codes} — that time is offered in more than one room.` };
        }
        if (entries.length > 4) {
          return { ok: false, reason: `A confirmed enrolment can have at most 4 courses; your preview currently has ${entries.length}.` };
        }
        const { tutorialClashPairs } = computePreviewOverlaps(allPreviewSlots());
        if (tutorialClashPairs.length > 0) {
          const [a, b] = tutorialClashPairs[0];
          return { ok: false, reason: `Tutorial clash: "${a}" overlaps with "${b}". Change one of these two tutorial times before confirming.` };
        }
        return { ok: true, choices: entries.map(([courseId, e]) => ({ courseId, tutorialSessionId: e.sessionId! })) };
      }

      function renderConfirmBlockedNote() {
        const result = computeConfirmPlan();
        confirmEnrolmentBtn.disabled = !result.ok;
        confirmBlockedNoteEl.hidden = result.ok;
        confirmBlockedNoteEl.textContent = result.ok ? "" : result.reason;
      }

      type DiffKind = "added" | "removed" | "changed" | "unchanged";
      type ConfirmDiffRow = { courseId: number; kind: DiffKind; before?: EnrollmentChoice; after?: EnrollmentChoice };

      // Compares the plan the preview would submit against `confirmedState`
      // (this client's mirror of what's actually saved) so the confirm
      // dialog can show exactly what's about to change, per-course, before
      // the write happens.
      function computeConfirmDiff(nextChoices: EnrollmentChoice[]): ConfirmDiffRow[] {
        const before = new Map(confirmedState.map((c) => [c.courseId, c]));
        const after = new Map(nextChoices.map((c) => [c.courseId, c]));
        const courseIds = new Set([...before.keys(), ...after.keys()]);
        const rows: ConfirmDiffRow[] = [];
        for (const courseId of courseIds) {
          const b = before.get(courseId);
          const a = after.get(courseId);
          if (b && !a) rows.push({ courseId, kind: "removed", before: b });
          else if (!b && a) rows.push({ courseId, kind: "added", after: a });
          else if (b && a && b.tutorialSessionId !== a.tutorialSessionId) rows.push({ courseId, kind: "changed", before: b, after: a });
          else if (b && a) rows.push({ courseId, kind: "unchanged", before: b, after: a });
        }
        const order: Record<DiffKind, number> = { added: 0, changed: 1, removed: 2, unchanged: 3 };
        rows.sort(
          (x, y) =>
            order[x.kind] - order[y.kind] ||
            (courseById.get(x.courseId)?.code ?? "").localeCompare(courseById.get(y.courseId)?.code ?? ""),
        );
        return rows;
      }

      function renderConfirmDiffInto(el: HTMLElement, rows: ConfirmDiffRow[]) {
        if (rows.length === 0) {
          el.innerHTML = "<p>Nothing to confirm — your preview matches your confirmed enrolment exactly.</p>";
          return;
        }
        const groups: Record<DiffKind, ConfirmDiffRow[]> = { added: [], changed: [], removed: [], unchanged: [] };
        for (const row of rows) groups[row.kind].push(row);
        const section = (label: string, kind: DiffKind, render: (row: ConfirmDiffRow) => string) =>
          groups[kind].length === 0
            ? ""
            : `<div class="diff-group diff-${kind}"><h4>${esc(label)}</h4><ul>${groups[kind].map((row) => `<li>${render(row)}</li>`).join("")}</ul></div>`;
        el.innerHTML = [
          section("Adding", "added", (row) => esc(describeChoice(row.courseId, row.after!.tutorialSessionId))),
          section(
            "Changing",
            "changed",
            (row) =>
              `${esc(describeChoice(row.courseId, row.before!.tutorialSessionId))} → ${esc(describeChoice(row.courseId, row.after!.tutorialSessionId))}`,
          ),
          section("Removing (withdrawing)", "removed", (row) => esc(describeChoice(row.courseId, row.before!.tutorialSessionId))),
          section("Unchanged", "unchanged", (row) => esc(describeChoice(row.courseId, row.after!.tutorialSessionId))),
        ].join("");
      }

      // Renders the saved, server-truth confirmed enrolment from
      // `confirmedState` alone — never from `preview` — so this list can
      // never accidentally reflect an unconfirmed edit. Session details are
      // looked up in `courseById` (the whole catalogue), which is what lets a
      // confirmed course that's no longer a candidate still display
      // correctly instead of vanishing.
      function renderConfirmedList() {
        confirmedEmptyNoteEl.hidden = confirmedState.length > 0;
        confirmedListEl.hidden = confirmedState.length === 0;
        loadConfirmedBtn.disabled = confirmedState.length === 0;
        const sorted = [...confirmedState].sort((a, b) =>
          (courseById.get(a.courseId)?.code ?? "").localeCompare(courseById.get(b.courseId)?.code ?? ""),
        );
        confirmedListEl.innerHTML = sorted
          .map((c) => {
            const course = courseById.get(c.courseId);
            const code = course?.code ?? `Course ${c.courseId}`;
            const session = course?.sessions.find((s) => s.id === c.tutorialSessionId);
            const timeHtml = session
              ? `${esc(session.label)}: ${DAY_ABBR[session.dayOfWeek]} ${fmtTime(session.startMinutes)}–${fmtTime(session.endMinutes)} — ${esc(session.location)}`
              : '<span class="conflict-note">that tutorial section no longer exists</span>';
            return `<li data-course-id="${c.courseId}">
              <span class="course-code">${esc(code)}</span> — ${timeHtml}
              <button type="button" class="withdraw-course-btn" data-course-id="${c.courseId}" data-course-code="${esc(code)}">Withdraw</button>
            </li>`;
          })
          .join("");
      }

      let confirmInFlight = false;

      confirmEnrolmentBtn.addEventListener("click", () => {
        const result = computeConfirmPlan();
        if (!result.ok) return; // button is disabled in this case; belt-and-braces guard
        renderConfirmDiffInto(confirmDialogDiffEl, computeConfirmDiff(result.choices));
        confirmDialogErrorEl.hidden = true;
        confirmDialogErrorEl.textContent = "";
        confirmDialogEl.hidden = false;
      });

      confirmDialogCancelBtn.addEventListener("click", () => {
        confirmDialogEl.hidden = true;
      });

      confirmDialogConfirmBtn.addEventListener("click", async () => {
        if (confirmInFlight) return;
        const result = computeConfirmPlan();
        if (!result.ok) {
          confirmDialogErrorEl.textContent = result.reason;
          confirmDialogErrorEl.hidden = false;
          return;
        }
        confirmInFlight = true;
        confirmDialogConfirmBtn.disabled = true;
        try {
          const res = await fetch("/api/enrollment", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ choices: result.choices }),
          });
          if (!res.ok) {
            const body = (await res.json().catch(() => null)) as { error?: string } | null;
            confirmDialogErrorEl.textContent = body?.error ?? `Confirm failed (${res.status}).`;
            confirmDialogErrorEl.hidden = false;
            return;
          }
          // Only on a confirmed success does confirmedState move — a failed
          // request above returns before this line, leaving confirmedState
          // (and the preview, which this handler never touches either way)
          // exactly as they were.
          confirmedState = result.choices;
          confirmDialogEl.hidden = true;
          confirmStatusEl.textContent = "Enrolment confirmed.";
          renderConfirmedList();
        } catch {
          confirmDialogErrorEl.textContent = "Confirm failed — check your connection and try again.";
          confirmDialogErrorEl.hidden = false;
        } finally {
          confirmInFlight = false;
          confirmDialogConfirmBtn.disabled = false;
        }
      });

      // Which confirmed courses can actually be loaded back into the preview
      // right now (still a candidate) vs which can't (removed as a candidate
      // since being confirmed) — shown explicitly in the load-preview dialog
      // rather than silently dropped, per CLAUDE.md.
      function loadableConfirmedSplit(): { loadable: EnrollmentChoice[]; skipped: EnrollmentChoice[] } {
        const loadable: EnrollmentChoice[] = [];
        const skipped: EnrollmentChoice[] = [];
        for (const choice of confirmedState) {
          (candidates.has(choice.courseId) ? loadable : skipped).push(choice);
        }
        return { loadable, skipped };
      }

      loadConfirmedBtn.addEventListener("click", () => {
        const { loadable, skipped } = loadableConfirmedSplit();
        const parts: string[] = [];
        if (loadable.length > 0) {
          parts.push(
            `<p>These will be loaded into your preview, replacing whatever's there now:</p><ul>${loadable
              .map((c) => `<li>${esc(describeChoice(c.courseId, c.tutorialSessionId))}</li>`)
              .join("")}</ul>`,
          );
        }
        if (skipped.length > 0) {
          parts.push(
            `<p class="incomplete-note">These are confirmed but no longer in your candidates, so they can't be loaded into the preview — they stay confirmed as-is. Add them back as a candidate on the <a href="/courses/">courses page</a> first if you want to edit them here too:</p><ul>${skipped
              .map((c) => `<li>${esc(describeChoice(c.courseId, c.tutorialSessionId))}</li>`)
              .join("")}</ul>`,
          );
        }
        loadPreviewDialogBodyEl.innerHTML = parts.join("") || "<p>Nothing to load.</p>";
        loadPreviewDialogEl.hidden = false;
      });

      loadPreviewDialogCancelBtn.addEventListener("click", () => {
        loadPreviewDialogEl.hidden = true;
      });

      loadPreviewDialogConfirmBtn.addEventListener("click", () => {
        const { loadable } = loadableConfirmedSplit();
        preview.clear();
        for (const choice of loadable) {
          const course = courseById.get(choice.courseId);
          const session = course?.sessions.find((s) => s.id === choice.tutorialSessionId);
          if (!session) continue;
          preview.set(choice.courseId, {
            dayOfWeek: session.dayOfWeek,
            startMinutes: session.startMinutes,
            endMinutes: session.endMinutes,
            sessionId: session.id,
          });
        }
        expandedCourseId = null;
        loadPreviewDialogEl.hidden = true;
        renderAll();
      });

      let withdrawCourseId: number | null = null;
      let withdrawInFlight = false;

      confirmedListEl.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".withdraw-course-btn");
        if (!button) return;
        withdrawCourseId = Number(button.dataset.courseId);
        withdrawDialogCourseEl.textContent = button.dataset.courseCode ?? String(withdrawCourseId);
        withdrawDialogErrorEl.hidden = true;
        withdrawDialogErrorEl.textContent = "";
        withdrawDialogEl.hidden = false;
      });

      withdrawDialogCancelBtn.addEventListener("click", () => {
        withdrawDialogEl.hidden = true;
        withdrawCourseId = null;
      });

      withdrawDialogConfirmBtn.addEventListener("click", async () => {
        if (withdrawInFlight || withdrawCourseId == null) return;
        const courseId = withdrawCourseId;
        withdrawInFlight = true;
        withdrawDialogConfirmBtn.disabled = true;
        try {
          const res = await fetch(`/api/enrollment?courseId=${courseId}`, { method: "DELETE" });
          if (!res.ok) {
            const body = (await res.json().catch(() => null)) as { error?: string } | null;
            withdrawDialogErrorEl.textContent = body?.error ?? `Withdraw failed (${res.status}).`;
            withdrawDialogErrorEl.hidden = false;
            return;
          }
          // Withdrawing only ever trims confirmedState by this one course —
          // never touches `candidates` or `preview` (CLAUDE.md: withdrawing
          // must never auto-remove a course from candidates).
          confirmedState = confirmedState.filter((c) => c.courseId !== courseId);
          withdrawDialogEl.hidden = true;
          withdrawCourseId = null;
          renderConfirmedList();
        } catch {
          withdrawDialogErrorEl.textContent = "Withdraw failed — check your connection and try again.";
          withdrawDialogErrorEl.hidden = false;
        } finally {
          withdrawInFlight = false;
          withdrawDialogConfirmBtn.disabled = false;
        }
      });

      // --- Phase 4: auto-schedule (optional) -----------------------------

      type GenPlanChoice = {
        courseId: number;
        code: string;
        dayOfWeek: number;
        startMinutes: number;
        endMinutes: number;
        sectionId: number | null;
        pending: boolean;
      };
      type GenPlan = {
        courses: GenPlanChoice[];
        daysOnCampus: number[];
        daysOnCampusCount: number;
        avoidDayMinutes: number;
        pendingCount: number;
      };
      type GenerateMode = "preview" | "candidates";
      // The ephemeral, purely-computed "generated results" state (PLAN.md's
      // fourth state, distinct from candidates/preview/confirmed) — never
      // persisted anywhere, never survives a navigation or reload. `snapshotKey`
      // records what candidates/required-flags/preferences (and, for mode
      // "preview", which courses were in the preview) looked like at generate
      // time, so a later change can be detected and the result marked stale
      // without needing every mutation site to remember to flag it.
      type GenerateResultState =
        | { ok: true; mode: GenerateMode; totalFeasible: number; capped: boolean; plans: GenPlan[]; page: number; snapshotKey: string }
        | { ok: false; mode: GenerateMode; reason: string }
        | null;

      let generateResult: GenerateResultState = null;
      const RESULTS_PAGE_SIZE = 10;

      function currentSnapshotKey(mode: GenerateMode): string {
        const candidatesKey = [...candidates.entries()]
          .sort((a, b) => a[0] - b[0])
          .map(([id, c]) => `${id}:${c.required ? 1 : 0}`)
          .join(",");
        const prefsKey = JSON.stringify(preferencesState);
        const previewKey = mode === "preview" ? [...preview.keys()].sort((a, b) => a - b).join(",") : "";
        return `${candidatesKey}|${prefsKey}|${previewKey}`;
      }

      async function runGenerate(mode: GenerateMode) {
        generatePreviewTimesBtn.disabled = true;
        generateFromCandidatesBtn.disabled = true;
        try {
          const body: { mode: GenerateMode; courseIds?: number[] } = { mode };
          if (mode === "preview") body.courseIds = [...preview.keys()];
          const res = await fetch("/api/plans/generate", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(body),
          });
          const json = await res.json();
          if (!res.ok) {
            generateResult = { ok: false, mode, reason: json.error ?? "Something went wrong generating a plan." };
          } else if (!json.ok) {
            generateResult = { ok: false, mode, reason: json.reason };
          } else {
            generateResult = {
              ok: true,
              mode,
              totalFeasible: json.totalFeasible,
              capped: json.capped,
              plans: json.plans,
              page: 0,
              snapshotKey: currentSnapshotKey(mode),
            };
          }
        } catch {
          generateResult = { ok: false, mode, reason: "Couldn't reach the server to generate a plan." };
        } finally {
          generatePreviewTimesBtn.disabled = false;
          generateFromCandidatesBtn.disabled = false;
          renderGenerateResults();
        }
      }

      // Same shape as allPreviewSlots()'s PreviewSlot, built from a generated
      // plan instead of the live preview — this is what lets the plan detail
      // view render through the exact same renderSlotsIntoGrid() the manual
      // preview grid uses, rather than a second, separately-written renderer.
      // A pending (section not yet chosen) time option's location reads "To
      // be chosen" here — never defaulted to one of its sections — matching
      // the same pending-room wording the manual preview's own grid uses.
      function planToDetailSlots(plan: GenPlan): PreviewSlot[] {
        const slots: PreviewSlot[] = [];
        for (const choice of plan.courses) {
          const course = courseById.get(choice.courseId);
          if (!course) continue;
          for (const lecture of course.sessions.filter((s) => s.kind === "lecture")) {
            slots.push({
              courseId: choice.courseId,
              label: `${course.code} ${lecture.label}`,
              session: { dayOfWeek: lecture.dayOfWeek, startMinutes: lecture.startMinutes, endMinutes: lecture.endMinutes, kind: "lecture" },
              location: lecture.location,
              pending: false,
            });
          }
          const section = choice.sectionId != null ? course.sessions.find((s) => s.id === choice.sectionId) : undefined;
          slots.push({
            courseId: choice.courseId,
            label: section ? `${course.code} ${section.label}` : `${course.code} tutorial (section pending)`,
            session: { dayOfWeek: choice.dayOfWeek, startMinutes: choice.startMinutes, endMinutes: choice.endMinutes, kind: "tutorial" },
            location: section ? section.location : "To be chosen",
            pending: choice.pending,
          });
        }
        return slots;
      }

      // Kept as a secondary, auxiliary rendering of the same slot list — a
      // plain day-grouped list inside a collapsed <details>, useful on a
      // narrow screen or as a quick scan — never the primary view any more.
      function renderPlanDetailList(slots: PreviewSlot[]) {
        const byDay = new Map<number, PreviewSlot[]>();
        for (const slot of slots) {
          const list = byDay.get(slot.session.dayOfWeek) ?? [];
          list.push(slot);
          byDay.set(slot.session.dayOfWeek, list);
        }
        const html = DAY_NAMES.map((name, day) => {
          const entries = byDay.get(day);
          if (!entries || entries.length === 0) return "";
          const sorted = [...entries].sort((a, b) => a.session.startMinutes - b.session.startMinutes);
          const items = sorted
            .map(
              (s) =>
                `<li class="${s.session.kind}${s.pending ? " pending" : ""}">${esc(s.label)} · ${fmtTime(s.session.startMinutes)}–${fmtTime(s.session.endMinutes)} · ${esc(s.location)}</li>`,
            )
            .join("");
          return `<div class="plan-detail-day"><h4>${esc(name)}</h4><ul>${items}</ul></div>`;
        }).join("");
        planDetailContentEl.innerHTML = html || "<p>No sessions in this plan.</p>";
      }

      function closePlanDetail() {
        planDetailModalEl.hidden = true;
        closeDetailPanel(planDetailSessionDetailEl);
        planDetailContentEl.innerHTML = "";
      }

      // Renders a generated plan's weekly schedule through the exact same
      // grid machinery the manual preview uses (classifyOverlap,
      // packOverlappingSlots, computeGridPosition, the lecture-hint/conflict
      // styling) — but into the plan-detail modal's own, separate grid
      // element, never the manual preview's `#weekly-grid`. Because this
      // never reads or writes the `preview` Map or touches `weeklyGridEl`,
      // viewing a plan can never change the manual preview, and closing the
      // modal (closePlanDetail) always leaves it exactly as it was.
      function renderPlanDetail(plan: GenPlan) {
        const slots = planToDetailSlots(plan);
        currentPlanDetailSlots = slots;
        closeDetailPanel(planDetailSessionDetailEl);
        renderSlotsIntoGrid(slots, planDetailGridEl, planDetailOutOfRangeEl);
        renderPlanDetailList(slots);
        planDetailPendingNoteEl.hidden = plan.pendingCount === 0;
        planDetailModalEl.hidden = false;
      }

      // Applying replaces whatever the affected preview entries currently
      // are with this plan's choices — for mode "preview" that's the same
      // course set (only times move), for mode "candidates" the whole
      // preview becomes exactly this plan's course set. A pending (multi-
      // section) choice keeps the preview's own already-chosen section only
      // if that section belongs to this exact course *and* this exact
      // day/start/end; otherwise it's left pending for the visitor to pick,
      // never defaulted.
      function applyGeneratedPlan(plan: GenPlan) {
        const nextEntries = new Map<number, PreviewEntry>();
        for (const choice of plan.courses) {
          let sessionId: number | null = choice.pending ? null : choice.sectionId;
          if (choice.pending) {
            const old = preview.get(choice.courseId);
            if (
              old &&
              old.dayOfWeek === choice.dayOfWeek &&
              old.startMinutes === choice.startMinutes &&
              old.endMinutes === choice.endMinutes &&
              old.sessionId != null
            ) {
              sessionId = old.sessionId;
            }
          }
          nextEntries.set(choice.courseId, {
            dayOfWeek: choice.dayOfWeek,
            startMinutes: choice.startMinutes,
            endMinutes: choice.endMinutes,
            sessionId,
          });
        }
        preview.clear();
        for (const [courseId, entry] of nextEntries) preview.set(courseId, entry);
        expandedCourseId = null;
        closePlanDetail();
        renderAll();
        renderGenerateResults();
      }

      function renderGenerateResults() {
        if (!generateResult) {
          generateResultsEl.hidden = true;
          return;
        }
        generateResultsEl.hidden = false;
        generateResultsHeadingEl.textContent =
          generateResult.mode === "preview"
            ? "Auto-scheduled tutorial times for your current preview"
            : "Generated plans from your candidates";

        if (!generateResult.ok) {
          generateResultsSummaryEl.innerHTML = `<span class="conflict-note">${esc(generateResult.reason)}</span>`;
          generateResultsBodyEl.innerHTML = "";
          generateResultsPaginationEl.innerHTML = "";
          return;
        }

        const stale = currentSnapshotKey(generateResult.mode) !== generateResult.snapshotKey;
        const totalPages = Math.max(1, Math.ceil(generateResult.plans.length / RESULTS_PAGE_SIZE));
        generateResult.page = Math.min(Math.max(0, generateResult.page), totalPages - 1);
        const pageStart = generateResult.page * RESULTS_PAGE_SIZE;
        const pagePlans = generateResult.plans.slice(pageStart, pageStart + RESULTS_PAGE_SIZE);

        const summaryParts = [
          `${generateResult.totalFeasible} feasible plan${generateResult.totalFeasible === 1 ? "" : "s"} found in total.`,
        ];
        if (generateResult.capped) {
          summaryParts.push(
            `Only the top ${generateResult.plans.length}, ranked by your enabled preferences, are listed below — the rest aren't shown.`,
          );
        }
        generateResultsSummaryEl.innerHTML = summaryParts.map((p) => esc(p)).join(" ") +
          (stale
            ? ' <strong class="conflict-note">These results are out of date — your candidates, preview or conditions changed since you generated them. Regenerate before applying.</strong>'
            : "");

        generateResultsBodyEl.innerHTML = pagePlans
          .map((plan, i) => {
            const globalIndex = pageStart + i;
            const courseList = plan.courses
              .map(
                (c) =>
                  `${esc(c.code)} ${DAY_ABBR[c.dayOfWeek]} ${fmtTime(c.startMinutes)}–${fmtTime(c.endMinutes)}${c.pending ? " (section pending)" : ""}`,
              )
              .join(", ");
            return `<article class="generated-plan-card">
              <p class="generated-plan-courses">${courseList}</p>
              <p class="generated-plan-meta">Days on campus (tutorials only): ${plan.daysOnCampusCount}${plan.pendingCount > 0 ? ` · ${plan.pendingCount} section${plan.pendingCount === 1 ? "" : "s"} still to choose` : ""}</p>
              <div class="generated-plan-actions">
                <button type="button" class="view-plan-btn" data-plan-index="${globalIndex}">View weekly schedule</button>
                <button type="button" class="apply-plan-btn" data-plan-index="${globalIndex}" ${stale ? "disabled" : ""}>Apply to current preview</button>
              </div>
            </article>`;
          })
          .join("");

        generateResultsPaginationEl.innerHTML =
          totalPages > 1
            ? `<button type="button" id="generate-page-prev" ${generateResult.page === 0 ? "disabled" : ""}>Previous</button>
               <span>Page ${generateResult.page + 1} of ${totalPages}</span>
               <button type="button" id="generate-page-next" ${generateResult.page === totalPages - 1 ? "disabled" : ""}>Next</button>`
            : "";
      }

      generatePreviewTimesBtn.addEventListener("click", () => runGenerate("preview"));
      generateFromCandidatesBtn.addEventListener("click", () => runGenerate("candidates"));

      generateResultsCancelBtn.addEventListener("click", () => {
        generateResult = null;
        renderGenerateResults();
      });

      generateResultsPaginationEl.addEventListener("click", (event) => {
        if (!generateResult?.ok) return;
        const target = event.target as HTMLElement;
        if (target.id === "generate-page-prev") generateResult.page -= 1;
        else if (target.id === "generate-page-next") generateResult.page += 1;
        else return;
        renderGenerateResults();
      });

      generateResultsBodyEl.addEventListener("click", (event) => {
        if (!generateResult?.ok) return;
        const viewBtn = (event.target as HTMLElement).closest<HTMLButtonElement>(".view-plan-btn");
        if (viewBtn) {
          const plan = generateResult.plans[Number(viewBtn.dataset.planIndex)];
          if (plan) renderPlanDetail(plan);
          return;
        }
        const applyBtn = (event.target as HTMLElement).closest<HTMLButtonElement>(".apply-plan-btn");
        if (applyBtn) {
          if (currentSnapshotKey(generateResult.mode) !== generateResult.snapshotKey) {
            renderGenerateResults();
            return;
          }
          const plan = generateResult.plans[Number(applyBtn.dataset.planIndex)];
          if (plan) applyGeneratedPlan(plan);
        }
      });

      planDetailCloseBtn.addEventListener("click", closePlanDetail);

      function readPreferencesFromForm(): PreferencesState {
        const blackoutDays = [...preferencesPanelEl.querySelectorAll<HTMLInputElement>(".blackout-day-checkbox:checked")].map(
          (cb) => Number(cb.dataset.day),
        );
        const avoidDays = [...preferencesPanelEl.querySelectorAll<HTMLInputElement>(".avoid-day-checkbox:checked")].map((cb) =>
          Number(cb.dataset.day),
        );
        const minimizeDaysOnCampus = (document.getElementById("minimize-days-checkbox") as HTMLInputElement).checked;
        const desiredCourseCount = Number(
          preferencesPanelEl.querySelector<HTMLInputElement>('input[name="desired-count"]:checked')?.value ?? 3,
        );
        return { desiredCourseCount, blackoutDays, softPreferences: { minimizeDaysOnCampus, avoidDays } };
      }

      async function savePreferences() {
        const body = readPreferencesFromForm();
        preferencesStatusEl.textContent = "Saving…";
        preferencesStatusEl.classList.remove("conflict-note");
        try {
          const res = await fetch("/api/preferences", {
            method: "PUT",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(body),
          });
          const json = await res.json();
          if (!res.ok) {
            preferencesStatusEl.textContent = json.error ?? "Couldn't save your conditions.";
            preferencesStatusEl.classList.add("conflict-note");
            return;
          }
          preferencesState = json;
          preferencesStatusEl.textContent = "Saved.";
        } catch {
          preferencesStatusEl.textContent = "Couldn't reach the server to save your conditions.";
          preferencesStatusEl.classList.add("conflict-note");
        } finally {
          // A saved preference change can invalidate an existing generated
          // result's snapshot key — re-render so a stale banner (and disabled
          // apply buttons) appear immediately rather than only on next click.
          renderGenerateResults();
        }
      }

      preferencesPanelEl.addEventListener("change", (event) => {
        const target = event.target as HTMLInputElement;
        if (
          target.matches(".blackout-day-checkbox") ||
          target.matches(".avoid-day-checkbox") ||
          target.id === "minimize-days-checkbox" ||
          target.name === "desired-count"
        ) {
          savePreferences();
        }
      });

      // Deliberately a separate listener from the "change" one below, on a
      // separate element (.schedule-card-toggle is a <button>, never the
      // checkbox) — this is what guarantees expand/collapse can't reach the
      // preview-include-checkbox's state, in either direction.
      scheduleListEl.addEventListener("click", (event) => {
        const toggle = (event.target as HTMLElement).closest<HTMLButtonElement>(".schedule-card-toggle");
        if (!toggle) return;
        const courseId = Number(toggle.dataset.courseId);
        expandedCourseId = expandedCourseId === courseId ? null : courseId;
        renderScheduleList();
      });

      scheduleListEl.addEventListener("change", (event) => {
        const target = event.target as HTMLInputElement;
        const courseId = Number(target.dataset.courseId);
        if (!courseId) return;
        if (target.classList.contains("preview-include-checkbox")) {
          if (target.checked) {
            preview.set(courseId, { dayOfWeek: null, startMinutes: null, endMinutes: null, sessionId: null });
            // Newly added — this is now "the course being edited", so open
            // it (and, being an accordion, implicitly close whatever else
            // was open) rather than leaving the visitor to hunt for a
            // now-just-appeared expand toggle.
            expandedCourseId = courseId;
          } else {
            preview.delete(courseId);
            if (expandedCourseId === courseId) expandedCourseId = null;
          }
          renderAll();
        } else if (target.classList.contains("tutorial-radio")) {
          const dayOfWeek = Number(target.dataset.day);
          const startMinutes = Number(target.dataset.start);
          const endMinutes = Number(target.dataset.end);
          const course = courseById.get(courseId)!;
          const options = groupTutorialTimeOptions(course.sessions.filter((s) => s.kind === "tutorial"));
          const option = options.find((o) => o.dayOfWeek === dayOfWeek && o.startMinutes === startMinutes && o.endMinutes === endMinutes)!;
          preview.set(courseId, {
            dayOfWeek,
            startMinutes,
            endMinutes,
            sessionId: option.sections.length === 1 ? option.sections[0].id : null,
          });
          renderAll();
        } else if (target.classList.contains("room-radio")) {
          const sessionId = Number(target.dataset.sessionId);
          const entry = preview.get(courseId);
          if (entry) preview.set(courseId, { ...entry, sessionId });
          renderAll();
        }
      });

      // Re-render once from the same embedded data the server used (after
      // reconciling the restored preview above), so the JS-driven view
      // starts consistent with what was already server-rendered before any
      // interaction happens.
      renderAll();
      renderConfirmedList();
